{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "r-lsp",
  "version": "1.0.0",
  "description": "R language server plugin for Claude Code",
  "owner": {
    "name": "ab604"
  },
  "plugins": [
    {
      "name": "r-lsp",
      "description": "R language server for code intelligence - diagnostics, go-to-definition, hover, references, and formatting via languageserver",
      "version": "1.0.0",
      "author": {
        "name": "ab604"
      },
      "source": "./plugins/r-lsp",
      "category": "development",
      "lspServers": {
        "r": {
          "command": "R",
          "args": ["--slave", "--no-save", "--no-restore", "-e", "languageserver::run()"],
          "extensionToLanguage": {
            ".R": "r",
            ".r": "r",
            ".Rmd": "rmd",
            ".rmd": "rmd",
            ".qmd": "quarto"
          },
          "initializationOptions": {
            "diagnostics": true
          }
        }
      }
    }
  ]
}
